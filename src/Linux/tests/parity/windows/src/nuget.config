<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!-- keep every NuGet package inside the sandbox directory, nothing in %USERPROFILE% -->
    <add key="globalPackagesFolder" value="C:\u1-parity\packages" />
  </config>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
