<?xml version="1.0" encoding="utf-8"?>
<!--
  WpfLinuxSdkProbe 专用的 NuGet 配置（只对本目录生效）：
  · wpflinux-local：本仓自产包 WpfLinux.Sdk（src/Linux/build/third-party/pkg/out）；
  · huaweicloud：本沙箱 api.nuget.org 不可达，OOB 包走镜像。
-->
<configuration>
  <packageSources>
    <clear />
    <add key="wpflinux-local" value="../../build/third-party/pkg/out" />
    <add key="huaweicloud" value="https://mirrors.huaweicloud.com/repository/nuget/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <clear />
  </packageSourceMapping>
</configuration>
