<Application x:Class="WpfTextDemo.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- 应用级资源：默认配置下 StaticResource 也必须能解析（BAML 资源解析路径） -->
        <SolidColorBrush x:Key="CardBrush" Color="#FF232E44" />
        <SolidColorBrush x:Key="CardStrokeBrush" Color="#FF44587A" />
    </Application.Resources>
</Application>
