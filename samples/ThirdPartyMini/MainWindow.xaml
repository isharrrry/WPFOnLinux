<Window x:Class="ThirdPartyMini.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:ThirdPartyMini"
        Title="ThirdPartyMini —— 第三方形态（WindowChrome + 图片 + BAML）"
        Width="900" Height="620" WindowStartupLocation="CenterScreen"
        Background="#FF1B1F27" Foreground="#FFEDEFF5"
        WindowStyle="None" ResizeMode="CanResize">
  <!-- ① WindowChrome：自定义 chrome。它走 SetWindowRgn/SetWindowPos 一族 —— 
       `SetWindowRgn` 曾经返 0（并把语义写错）⇒ 任何 WindowChrome 应用必崩，本工程修好后返 1。 -->
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6"
                        GlassFrameThickness="0" CornerRadius="0"
                        UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- 自定义标题栏（第三方总会自己做一条） -->
    <Border Grid.Row="0" Background="#FF2B3242" CornerRadius="6" Padding="10,6" Margin="0,0,0,12">
      <DockPanel>
        <TextBlock Text="ThirdPartyMini" FontSize="20" FontWeight="Bold" DockPanel.Dock="Left"/>
        <TextBlock Text="  第三方形态：只通过 build/third-party/WpfLinux.props 接线" FontSize="12"
                   Foreground="#FF9FB0C8" VerticalAlignment="Center" DockPanel.Dock="Left"/>
        <TextBlock Text="✕" FontSize="18" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
      </DockPanel>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" Margin="0,0,10,0">
        <TextBlock Text="② 图片解码（走 WIC → Skia）" FontSize="15" FontWeight="Bold" Margin="0,0,0,6"/>
        <Border BorderBrush="#FF4A5568" BorderThickness="1" CornerRadius="4" Padding="6">
          <Image x:Name="DecodedImage" Height="150" Stretch="Uniform"/>
        </Border>
        <TextBlock x:Name="ImageStatus" Foreground="#FF9FB0C8" FontSize="12" Margin="0,6,0,0"
                   TextWrapping="Wrap"/>
        <TextBlock Text="③ 中文与图标（字体回退 + 段落排版）" FontSize="15" FontWeight="Bold" Margin="0,16,0,6"/>
        <TextBlock FontSize="14" TextWrapping="Wrap"
                   Text="在 Linux 上渲染中文：字体匹配、逐字形 shaping、行高与基线都要对。"/>
        <TextBlock FontSize="13" Margin="0,6,0,0" Foreground="#FFB9C6DA"
                   Text="★ ✓ ✕ ● ■ ▲ ⏵ ⌛ ⇧ ⌘ — 图标字形"/>
      </StackPanel>

      <StackPanel Grid.Column="1">
        <TextBlock Text="④ 数据绑定 + 虚拟化列表" FontSize="15" FontWeight="Bold" Margin="0,0,0,6"/>
        <ListBox x:Name="ItemsList" Height="330" Background="#FF232936" Foreground="#FFEDEFF5"
                 BorderBrush="#FF4A5568" ItemsSource="{Binding Items}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Id}" Width="46" Foreground="#FF7FD1AE"/>
                <TextBlock Text="{Binding Name}"/>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="BindStatus" Foreground="#FF9FB0C8" FontSize="12" Margin="0,6,0,0"/>
      </StackPanel>
    </Grid>

    <Border Grid.Row="2" Background="#FF2B3242" CornerRadius="6" Padding="10,6" Margin="0,12,0,0">
      <StackPanel Orientation="Horizontal">
        <TextBlock x:Name="Footer" FontSize="12" Foreground="#FFB9C6DA"/>
        <!-- ⚠️ `#38` B4：这里引用的是**internal** 类型 ⇒ PBT 生成 GeneratedInternalTypeHelper
             ⇒ LoadBaml 走 XamlAccessLevel（官方包在非 Windows 上必抛；替身不抛）。 -->
        <local:InternalBadge Margin="12,0,0,0" FontSize="12" Foreground="#FF7FD1AE"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
