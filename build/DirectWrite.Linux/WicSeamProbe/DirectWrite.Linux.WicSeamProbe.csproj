<Project Sdk="Microsoft.NET.Sdk">
  <!-- ⭐ `D-R8`（工程卫生）：不依赖 `$(BaseIntermediateOutputPath)` 指向哪里的产物目录排除。
       实现在仓根 `BuildHygiene.props`（全仓唯一一份；理由与两种被否决的落点见 `build/MilBridge/W21B-report.md` §2）。
       **故意不加 `Exists()` 条件**：文件找不到要大声失败。 -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('BuildHygiene.props'))" />
  <!--
    T2 · WIC seam 探针（主控指定：**先做这一步再写 22 个函数**）
    验证上游 BitmapDecoder.GetSeekableStream 走 CreateDecoderFromFileHandle 时，
    FileStream.SafeFileHandle 是不是**真 Linux fd**（而不是 Win32 HANDLE）。
    若是真 fd ⇒ WIC shim 可以直接 pread(fd) 拿到字节，与 Win32 shim / MilCore 零耦合。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AssemblyName>DirectWrite.Linux.WicSeamProbe</AssemblyName>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <BaseOutputPath>$(MSBuildThisFileDirectory)bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)obj\</BaseIntermediateOutputPath>
  </PropertyGroup>
</Project>
