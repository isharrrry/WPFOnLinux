<?xml version="1.0" encoding="utf-8"?>
<!--
  MilBridge 局部 NuGet 源：与工程根 build/NuGet.config 同源（华为镜像）。
  放在这里是为了让 build/MilBridge/ 下的工程无论从哪里调用都拿到一致的源，
  而不必改动共享的 build/NuGet.config。
-->
<configuration>
  <packageSources>
    <clear />
    <add key="huaweicloud" value="https://mirrors.huaweicloud.com/repository/nuget/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <clear />
  </packageSourceMapping>
</configuration>
