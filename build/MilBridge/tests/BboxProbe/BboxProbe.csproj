<Project Sdk="Microsoft.NET.Sdk">
  <!-- ⭐ `D-R8`（工程卫生）：不依赖 `$(BaseIntermediateOutputPath)` 指向哪里的产物目录排除。
       实现在仓根 `BuildHygiene.props`（全仓唯一一份；理由与两种被否决的落点见
       `build/MilBridge/W21B-report.md` §2）。**故意不加 `Exists()` 条件**：文件找不到要大声失败。 -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('BuildHygiene.props'))" />
  <!-- T1b · 逐字形 bbox 探针（**不依赖 shim**：直接 P/Invoke HarfBuzz 的 glyph extents）
       目的：定位 `Extent`（墨迹上伸）余差由**哪一类字形的 bbox** 解释（主控 2026-09-11 批准，只定位不改实现） -->
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <AssemblyName>MilBridge.BboxProbe</AssemblyName><AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable><ImplicitUsings>disable</ImplicitUsings>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <BaseOutputPath>$(MSBuildThisFileDirectory)bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)obj\</BaseIntermediateOutputPath>
  </PropertyGroup>
</Project>
