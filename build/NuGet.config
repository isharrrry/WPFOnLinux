<?xml version="1.0" encoding="utf-8"?>
<!--
  WPF-on-Linux 工程 NuGet 源配置。

  背景：本沙箱 api.nuget.org 被 TLS 阻断（curl 返回 000 / SSL_ERROR_SYSCALL），
  因此不再使用官方源，改为国内可达镜像。setup-env.sh 会把本文件安装到
  用户级配置 ~/.nuget/NuGet/NuGet.Config，从而对 /workspace 下所有工程生效。

  注意：clear / 会移除机器上任何既有源，保证复现性（避免本地缓存源造成版本漂移）。
-->
<configuration>
  <packageSources>
    <clear />
    <add key="huaweicloud" value="https://mirrors.huaweicloud.com/repository/nuget/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <clear />
  </packageSourceMapping>
</configuration>
