<Project>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <Import Project="$(MSBuildThisFileDirectory)../Directory.Upstream.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>PresentationFramework</AssemblyName>
    <RootNamespace>MS.Internal</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <NoWarn>$(NoWarn);0618;CS3016;CS0067;CS0169;CS0414;CS0649;CS1591;CS8632;CS0219;CS8981;CA1416;1058;SYSLIB5005;CA1420;WPF0001</NoWarn>
    <DefineConstants>FRAMEWORK_NATIVEMETHODS;COMMONDPS;PRESENTATIONFRAMEWORK_ONLY;PRESENTATIONFRAMEWORK;RIBBON_IN_FRAMEWORK;WINDOWS_BASE_OR_PC</DefineConstants>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnablePInvokeAnalyzer>false</EnablePInvokeAnalyzer>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <SignAssembly>true</SignAssembly>
    <PublicSign>true</PublicSign>
    <AssemblyOriginatorKeyFile>$(WpfLinuxRoot)build/keys/WcpPublicKey.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="9.0.0" />
    <PackageReference Include="System.Formats.Nrbf" Version="9.0.0" />
    <PackageReference Include="System.IO.Packaging" Version="9.0.0" />
    <!-- ── `#38` 波：官方包换成 Linux 原生替身（**编译期也不许用包**）──────────────
        官方包在非 Windows 上把 `XamlAccessLevel`/`SoundPlayer` 等实现成**必抛**桩，只有 `runtimes/win` 是真的
        ⇒ 任何生成 `GeneratedInternalTypeHelper` 的程序集一装 BAML 就崩（实测：第三方应用 HandyControl）。
    
        ⚠️ **为什么留着包引用、却把 compile/runtime 资产排除掉**（`#38` 实测的根因）：
          `System.Security.Permissions 9.0.0` **传递依赖** `System.Windows.Extensions 9.0.0`
          ⇒ 就算把直接包引用**整条删掉**，restore 仍会把包拉回来（`project.assets.json` 里 SWE 命中 14 处），
          RAR 于是**按包**解析（包是**签名的**，`PublicKeyToken=cc7b13ffcd2ddd51`），
          而 `System.Xaml` 的 `TypeForwardedTo(XamlAccessLevel)` 也就带着**包的身份**，
          最终 `PresentationFramework` 报 `CS0012`（"类型 XamlAccessLevel 在未引用的程序集中定义"）。
          ⇒ 必须让**包在编译期一个字都不出现**：`ExcludeAssets="compile;runtime"`（只留它作依赖图的占位）。
          ⚠️ `#36` 只试过 `ExcludeAssets="runtime"` —— **编译资产还在** ⇒ 包照样赢（那条否证不适用于本形态）。
    
        实现由下面的 `<Reference>` 提供：同名程序集、`AssemblyVersion=9.0.0.0`（与 deps.json 对齐）、**不抛**。
        依赖图里 SWE 的**运行期**资产被排除 ⇒ 包那份 dll **不会**被拷进输出，替身会（`<Private>true</Private>`）。 -->
    <PackageReference Include="System.Windows.Extensions" Version="9.0.0" ExcludeAssets="compile;runtime" />
    <Reference Include="System.Windows.Extensions">
      <HintPath>$(WpfLinuxRoot)build/System.Windows.Extensions.Linux/bin/$(Configuration)/System.Windows.Extensions.dll</HintPath>
      <Private>true</Private>
    </Reference>

  </ItemGroup>
  <ItemGroup>
    <Reference Include="ReachFramework"><HintPath>$(WpfLinuxRoot)build/ReachFramework.Linux/bin/$(Configuration)/ReachFramework.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="PresentationCore"><HintPath>$(WpfLinuxRoot)build/PresentationCore.Linux/bin/$(Configuration)/PresentationCore.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="System.Xaml"><HintPath>$(WpfLinuxRoot)build/System.Xaml.Linux/bin/$(Configuration)/System.Xaml.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="WindowsBase"><HintPath>$(WpfLinuxRoot)build/WindowsBase.Linux/bin/$(Configuration)/WindowsBase.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="UIAutomationTypes"><HintPath>$(WpfLinuxRoot)build/UIAutomationTypes.Linux/bin/$(Configuration)/UIAutomationTypes.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="UIAutomationProvider"><HintPath>$(WpfLinuxRoot)build/UIAutomationProvider.Linux/bin/$(Configuration)/UIAutomationProvider.dll</HintPath><Private>true</Private></Reference>
  </ItemGroup>
