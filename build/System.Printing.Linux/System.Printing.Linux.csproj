<Project>
  <!--
    ==========================================================================
    System.Printing（Linux 移植）—— **手写**工程，非 port-lib 生成
    ==========================================================================
    为什么手写：上游 System.Printing 的**实现是 C++**（`System.Printing/System.Printing.vcxproj` +
    `CPP/`），它的**托管面只存在于** `System.Printing/ref/System.Printing-ref.csproj`
    （2 个 .cs：`System.Printing.cs` 785 行公开 API + `System.Printing.internals.cs` 86 行
    `MS.Internal.PrintWin32Thunk` 内部面，全部 `throw null` API 形态）。
    而 port-lib 的 `find_csproj()` 会过滤掉路径含 `/ref/` 的候选、`ProjectReference` 解析也会跳过
    `*-ref` —— 两条规则本意是「跳过自引用 ref 程序集」，却让这个**唯一托管面**不可达。
    ⇒ 本工程按上游 ref csproj 逐项等价手写（不改 port-lib，属已留档的口径缺口 #2）。

    上游 ref csproj 的关键项（`System.Printing/ref/System.Printing-ref.csproj`）：
      AssemblyName=System.Printing；AllowUnsafeBlocks=true；EnableDefaultItems=false；
      Compile = System.Printing.cs + System.Printing.internals.cs + $(WpfSharedDir)RefAssemblyAttrs.cs；
      ProjectReference = PC-ref / System.Xaml-ref / WindowsBase-ref / UIAutomationProvider-ref /
                         UIAutomationTypes-ref（本项目改用**真 DLL** 等价替代）
                       + 2 个 CycleBreakers（上游快照无此目录，见 §CycleBreakers 说明）
    ==========================================================================
  -->
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <Import Project="$(MSBuildThisFileDirectory)../Directory.Upstream.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>System.Printing</AssemblyName>
    <RootNamespace>MS.Internal</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <!-- CS8002：本工程公开签名（身份口径）而 WindowsBase 在本移植工程中未签名 —— 上游全签名故无此警告 -->
    <NoWarn>$(NoWarn);0618;CS3016;CS0067;CS0169;CS0414;CS0649;CS1591;CS8632;CS0219;CS8981;CS8002;CA1416;CA1420;WPF0001</NoWarn>
    <!-- RefAssemblyAttrs.cs 的 #if 链没有 System.Printing 分支 → 走 #else namespace Microsoft.Internal，
         与上游一致（internals.cs 里引用的正是 Microsoft.Internal.BuildInfo.ReachFramework）。 -->
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnablePInvokeAnalyzer>false</EnablePInvokeAnalyzer>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <!-- 上游 System.Printing-ref.csproj:9（port-lib 未搬运；本工程手写，按上游原样保留） -->
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <!-- 公开签名：internals.cs 用 BuildInfo.ReachFramework（WCP 公钥）授予 ReachFramework 友元；
         本程序集自身也被 ReachFramework 之外的消费方按 WCP 家族对待，统一公开签名口径。 -->
    <SignAssembly>true</SignAssembly>
    <PublicSign>true</PublicSign>
    <AssemblyOriginatorKeyFile>$(WpfLinuxRoot)build/keys/WcpPublicKey.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="PresentationCore"><HintPath>$(WpfLinuxRoot)build/PresentationCore.Linux/bin/Debug/PresentationCore.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="System.Xaml"><HintPath>$(WpfLinuxRoot)build/System.Xaml.Linux/bin/Debug/System.Xaml.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="WindowsBase"><HintPath>$(WpfLinuxRoot)build/WindowsBase.Linux/bin/Debug/WindowsBase.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="UIAutomationTypes"><HintPath>$(WpfLinuxRoot)build/UIAutomationTypes.Linux/bin/Debug/UIAutomationTypes.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="UIAutomationProvider"><HintPath>$(WpfLinuxRoot)build/UIAutomationProvider.Linux/bin/Debug/UIAutomationProvider.dll</HintPath><Private>true</Private></Reference>
  </ItemGroup>

  <!-- CycleBreakers 替身（编译期专用，<Private>false</Private> 绝不进输出）：
       上游 System.Printing-ref.csproj:31-32 引用两个 CycleBreakers 工程，而该目录在本上游快照
       **不存在** → 用 build/CycleStub.* 的等价替身。替身的 AssemblyName 就是真程序集名
       （PresentationFramework / ReachFramework），故 System.Printing.dll 里的类型引用在**运行期**
       自动绑定到真程序集（替身只参与编译）。详见两个替身工程的头部注释。 -->
  <ItemGroup Condition="Exists('$(WpfLinuxRoot)build/CycleStub.PresentationFramework.Linux/bin/Debug/PresentationFramework.dll')">
    <Reference Include="PresentationFramework"><HintPath>$(WpfLinuxRoot)build/CycleStub.PresentationFramework.Linux/bin/Debug/PresentationFramework.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup Condition="Exists('$(WpfLinuxRoot)build/CycleStub.ReachFramework.Linux/bin/Debug/ReachFramework.dll')">
    <Reference Include="ReachFramework"><HintPath>$(WpfLinuxRoot)build/CycleStub.ReachFramework.Linux/bin/Debug/ReachFramework.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.IO.Packaging" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="$(UpstreamWpfRoot)src/Microsoft.DotNet.Wpf/src/System.Printing/ref/System.Printing.cs" />
    <Compile Include="$(UpstreamWpfRoot)src/Microsoft.DotNet.Wpf/src/System.Printing/ref/System.Printing.internals.cs" />
    <Compile Include="$(UpstreamWpfRoot)src/Microsoft.DotNet.Wpf/src/Shared/RefAssemblyAttrs.cs" />
  </ItemGroup>

  <!-- 自产程序集身份：AssemblyVersion 4.0.0.1（> 框架门面 4.0.0.0） -->
  <ItemGroup>
    <Compile Include="$(WpfLinuxRoot)build/shims/LinuxAssemblyIdentity.cs" />
  </ItemGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
