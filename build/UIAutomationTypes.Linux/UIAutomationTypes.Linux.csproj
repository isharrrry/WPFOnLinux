  <!-- WPF-on-Linux 兼容层：build/shims 下手写的等价类型（上游零改动） -->
  <ItemGroup>
    <Compile Include="$(WpfLinuxRoot)build/shims/Win32ShimResolver.cs" />
    <Compile Include="$(WpfLinuxRoot)build/shims/Accessibility.Shim.cs" />
  </ItemGroup>
  <!-- 自产程序集身份：AssemblyVersion 4.0.0.1，必须 > 框架门面的 4.0.0.0 -->
  <ItemGroup>
    <Compile Include="$(WpfLinuxRoot)build/shims/LinuxAssemblyIdentity.cs" />
  </ItemGroup>
  <!-- 程序集清单资源：ManifestResourceName 必须显式（RootNamespace 被本脚本统一为
       MS.Internal，靠 SDK 推导会与 gen-sr.py 的 SR 基名不一致 → 资源表静默失效） -->
  <ItemGroup>
    <EmbeddedResource Include="$(UpstreamWpfRoot)src/Microsoft.DotNet.Wpf/src/UIAutomation/UIAutomationTypes/Resources/Strings.resx">
      <ManifestResourceName>UIAutomationTypes.Resources.Strings</ManifestResourceName>
    </EmbeddedResource>
  </ItemGroup>
  <!-- ==== WPF-on-Linux D2：UIA 保留值短路（由 tools/patch-uiautomationtypes-reservedvalue.py 注入）==== -->
  <ItemGroup>
    <Compile Remove="$(UpstreamWpfRoot)src/Microsoft.DotNet.Wpf/src/UIAutomation/UIAutomationTypes/MS/Internal/Automation/UiaCoreTypesApi.cs" />
    <Compile Include="$(WpfLinuxRoot)build/UIAutomationTypes.Linux/UiaCoreTypesApi.Linux.cs" />
  </ItemGroup>
  <!-- ==== WPF-on-Linux D2 结束 ==== -->
